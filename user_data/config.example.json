{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "personal-kraken-btc-eur-dryrun",
  "initial_state": "running",
  "max_open_trades": 1,
  "stake_currency": "EUR",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "EUR",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "timeframe": "1h",
  "cancel_open_orders_on_exit": false,
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.dryrun.sqlite",
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/EUR"
    ],
    "pair_blacklist": []
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "CHANGE_ME_LOCAL_JWT_SECRET",
    "ws_token": "CHANGE_ME_LOCAL_WS_TOKEN",
    "CORS_origins": [],
    "username": "freqtrade",
    "password": "CHANGE_ME_LOCAL_PASSWORD"
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "internals": {
    "process_throttle_secs": 5
  }
}
